rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wordcloud_words/{document} {
      // Demo data may be read by the teaching page. Public writes stay blocked until auth, App Check, or a short-lived activity flow is added.
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
